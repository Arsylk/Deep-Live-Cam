# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyc

# --- IDE / editor ---
.idea/
.vscode/
.todo

# --- logs / backups / temp ---
*.log
*.backup
.tmp/
temp/
tmp/
:memory:.ses

# --- virtual envs ---
.venv/
venv/
env/
tf_env/

# --- heavy model files (fetched separately, never committed) ---
models/*
!models/instructions.txt
base/
*.onnx
gfpgan/
faceswap/

# --- local working state ---
.remember/
deployment-backups/
workflow/
switch_states.json
/benchmark-results/
/evaluation/results/

# --- binary media (screenshots/demos); keep intentional repo media ---
*.png
!arch-linux/assets/deep-live-cam.png
!media/Download.png
!media/instruction.png
*.mp4
*.mkv

# --- android build artifacts ---
android/**/build/
android/vcam-app/.gradle/
android/vcam-app/local.properties
*.apk

# --- android release zips (versioned build outputs, fetched on demand) ---
android/*.zip

# --- fetched / device-built packs ---
android/vcam-mobile-app/model-pack/
android/vcam-mobile-app/third_party/
arch-linux/runtime/